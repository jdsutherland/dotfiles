{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/dcg"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.local/share/fleet/plugin/hooks/codex/codex-hook.sh PreToolUse",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.local/share/fleet/plugin/hooks/codex/codex-hook.sh Stop",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
