{
  "permissions": {
    "additionalDirectories": [
      "~/.claude"
    ],
    "allow": [
      "WebSearch",
      "Bash(curl:*)",
      "Bash(sh)",
      "Bash(source ~/.zshrc)",
      "Bash(brew install:*)",
      "Bash(~/.local/bin/mise doctor:*)",
      "Bash(brew bundle:*)",
      "Bash(grep:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Skill(ship)",
      "Skill(always-allow)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dcg"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true
  },
  "syntaxHighlightingDisabled": false,
  "tui": "fullscreen",
  "theme": "auto",
  "agentPushNotifEnabled": true
}
