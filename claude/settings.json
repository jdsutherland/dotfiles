{
  "permissions": {
    "additionalDirectories": [
      "~/.claude"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude/hooks/rm-guard.sh",
            "statusMessage": "Checking rm targets"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true
  },
  "syntaxHighlightingDisabled": false,
  "tui": "fullscreen",
  "theme": "auto",
  "agentPushNotifEnabled": true
}
