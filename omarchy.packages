# Portable official-repository packages to restore on top of a fresh Omarchy
# install. This is curated from `pacman -Qqe`: Omarchy's own baseline,
# hardware-specific packages, duplicate language runtimes managed by mise, and
# packages with dedicated bootstrap steps are intentionally omitted.
# Installed via `pacman -S --needed` in scripts/omarchy.sh.

# Dotfile and shell dependencies
bc
gemini-cli
ghostty
git-delta
ranger
rsync
tree
vivid
wlsunset
zsh

# Additional CLI and development tools
bpftrace
dust
fish
hurl
iotop
lsof
mitmproxy
onefetch
strace
sysstat
tealdeer
tokei
uv
viu
xh

# Applications, services, and supporting packages
1password
1password-cli
anki
foliate
freerdp
fwupd
minecraft-launcher
noto-fonts-extra
openbsd-netcat
signal-desktop
spotify
tailscale
typora
xmlstarlet
