{
  // Extends the Quickshell Omarchy menu (SUPER+SPACE). Stock definitions live
  // in /usr/share/omarchy/default/omarchy/omarchy-menu.jsonc.
  //
  // Two things the stock file's own comments get wrong, both found the hard
  // way by reading shell/plugins/menu/{Menu.qml,MenuModel.js}:
  //
  // 1. It documents a "keywords" field. For JSONC rows that field is never
  //    read -- MenuModel.js builds the search haystack as
  //        [label, leafId, aliases.join(" ")]
  //    so search terms have to go in "aliases". (Menu.qml does honour
  //    keywords, but only for .desktop application entries, a separate path.)
  //
  // 2. It says reusing an id keeps existing fields unless overridden. It does
  //    not. parseMenuJsonc() runs normalizeItem() on every entry *before*
  //    mergeMenuSources() runs, and normalizeItem fills in every key with
  //    defaults (label falls back to the id, action to "", kind to "menu").
  //    So a partial override arrives fully populated with blanks and clobbers
  //    the stock row -- the entry becomes an empty submenu named after its id.
  //    Rows below are therefore re-declared in full, copied verbatim from the
  //    stock file, with aliases added.
  //
  // Aliases double as `omarchy menu summon <alias>` routes and resolve
  // first-match-wins; these were checked against the stock file for
  // collisions. Use arrays -- a bare string counts as a single alias rather
  // than being split on spaces.

  // Alfred parity: type "ocr" to OCR a screen region straight to the
  // clipboard. omarchy-capture-text already does the work (hyprpicker freeze
  // -> slurp region -> grim -> tesseract -> wl-copy) and is bound to
  // SUPER+CTRL+PRINT, but its label and leaf id are both just "text", so
  // "ocr" matched nothing.
  "trigger.capture.text": {
    "icon": "󰴑",
    "label": "Text",
    "action": "omarchy-capture-text",
    "aliases": ["ocr", "extract-text", "grab-text", "tesseract"]
  },

  // Same idea for the two neighbours, equally hard to find by name.
  "trigger.capture.qr": {
    "icon": "󰐲",
    "label": "QR Code",
    "action": "omarchy-capture-qr",
    "aliases": ["qr", "qrcode", "barcode"]
  },
  "trigger.capture.color": {
    "icon": "󰃉",
    "label": "Color",
    "action": "pkill hyprpicker || hyprpicker -a",
    "aliases": ["color", "colour", "picker", "eyedropper"]
  },

  // Alfred parity: "sp $WORD" / "def $WORD" typed as one string into
  // Alfred's bar. Omarchy's menu can't parse a keyword plus an inline
  // free-text argument from the same search box (providers are bound to a
  // submenu id, not to the live search text -- confirmed reading
  // MenuModel.js), so this is two Enters instead of one: pick the row, then
  // type the word into the prompt it opens. New ids, not stock overrides,
  // so no clobbering risk here -- see bin/omarchy-spell-suggest and
  // bin/omarchy-define-word for the actual lookups.
  "tools": { "icon": "󰗊", "label": "Word Tools" },
  "tools.spell": {
    "icon": "󰓆",
    "label": "Spelling Suggestions",
    "action": "omarchy-spell-suggest",
    "aliases": ["sp", "spell", "spelling", "spellcheck"]
  },
  "tools.define": {
    "icon": "󰗊",
    "label": "Define Word",
    "action": "omarchy-define-word",
    "aliases": ["def", "define", "definition", "dictionary", "meaning"]
  }
}
