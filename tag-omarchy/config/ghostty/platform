# Theme — driven by `omarchy theme set`, which writes the palette to
# ~/.local/state/omarchy/current/theme/ghostty.conf (see omarchy's own ghostty
# template). The ?"..." form is optional so a missing theme state on a fresh
# boot doesn't error.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Smaller than mac's 12pt -- same font renders visually larger on this
# Linux/GTK stack. 9 matches what 3 manual ctrl+minus presses landed on.
font-size = 9

# These currently match Ghostty's own Linux defaults (verified via
# `ghostty +show-config`), but declared explicitly so this repo doesn't
# silently depend on upstream defaults staying that way.
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
