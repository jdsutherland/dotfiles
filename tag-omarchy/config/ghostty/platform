# Theme — driven by `omarchy theme set`, which writes the palette to
# ~/.local/state/omarchy/current/theme/ghostty.conf (see omarchy's own ghostty
# template). The ?"..." form is optional so a missing theme state on a fresh
# boot doesn't error.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Slightly larger terminal text for the denser 1.6x Hyprland monitor scale.
font-size = 10

# Test whether the visible bottom strip is terminal padding vs cell-grid
# rounding. If a strip remains after reload, it is leftover pixels that cannot
# fit another full character row at the current font metrics/window size.
window-padding-x = 0
window-padding-y = 0
# Spread leftover pixels across the top/bottom instead of dumping all extra
# grid slack at the bottom edge. This does not create another text row; it makes
# cell-grid rounding look intentional/centered.
window-padding-balance = true

# Keep glyph weight, but tighten row height a bit.
adjust-cell-height = -1

# These currently match Ghostty's own Linux defaults (verified via
# `ghostty +show-config`), but declared explicitly so this repo doesn't
# silently depend on upstream defaults staying that way.
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard

# Override Ghostty's default shift+insert=paste_from_selection. Omarchy's
# SUPER+V "universal paste" bind (default/hypr/bindings/clipboard.lua) sends
# shift+insert to any window tagged "terminal", on the classic xterm
# assumption that ctrl+v means something else in a raw shell. But
# paste_from_selection reads Wayland's PRIMARY selection (auto-populated by
# mouse-highlighting text), not CLIPBOARD -- and nothing in this setup ever
# writes to PRIMARY. tmux copy-mode, keyd's clipboard-history bind, and
# ctrl+shift+v here all go through wl-copy, which only sets CLIPBOARD. So
# SUPER+V in Ghostty pasted whatever was last mouse-selected somewhere, not
# what was actually copied. Confirmed live: `wl-paste` (CLIPBOARD) had the
# real copied text while `wl-paste --primary` had unrelated stale content.
keybind = shift+insert=paste_from_clipboard
