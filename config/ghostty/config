# Ghostty config — translated from Alacritty
# https://ghostty.org/docs/config/reference

# Window
window-decoration = none
maximize = true

# Font
term = xterm-ghostty
font-family = Maple Mono NF
# font-size differs per platform -- see platform (mac) / tag-omarchy/config/ghostty/platform (Omarchy).

# Theme — Kanagawa Dragon (built-in)
theme = Kanagawa Dragon

# Cursor
cursor-style = block

# Mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = 3

# Scrollback
scrollback-limit = 1000000

# Clipboard
clipboard-read = ask
clipboard-write = allow

# Key bindings
# Clipboard binds differ per platform (mac: super+v/c; Linux: ctrl+shift+v/c)
# -- see platform (mac) / tag-omarchy/config/ghostty/platform (Omarchy).
config-file = platform
keybind = ctrl+slash=text:\x1f
keybind = ctrl+q=esc:\x11
keybind = alt+delete=reset_font_size
keybind = alt+equal=increase_font_size:1
keybind = alt+minus=decrease_font_size:1

bell-features = no-attention
fullscreen = false
confirm-close-surface = false
