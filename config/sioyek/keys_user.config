# Content-aware fitting: unlike the stock width fit, these ignore white margins.
fit_to_page_width_smart =
fit_to_page_height_smart W

# Fit the complete physical page height, including margins. This pairs with
# plain J/K for stable, fixed-zoom spread navigation in two-page mode.
fit_to_page_height w

# Toggle consecutive pages side by side.
toggle_two_page_mode T

# Vim-style jump-list navigation. Ctrl+O overrides Sioyek's default embedded
# document opener; Ctrl+Shift+O still opens one rooted at the current document.
prev_state <C-o>
next_state <C-i>

# Move by a complete page, or a complete spread in two-page mode.
next_page J
next_page <space>
previous_page K
previous_page <S-<space>>

# Move a spread, then fit the complete physical page height (the same as w).
next_page;fit_to_page_height <C-j>
previous_page;fit_to_page_height <C-k>
