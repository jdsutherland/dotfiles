# Start each Sioyek session in two-page mode, fitted to the document's content
# width while ignoring PDF white margins, with the status bar hidden. Press = to
# reapply the fit after changing zoom, T to toggle spreads, and \\ to show/hide
# the status bar.
startup_commands toggle_two_page_mode;fit_to_page_width_smart;toggle_statusbar

# Use Sioyek's bundled fzf-style fuzzy ranking in searchable selectors such as
# the command palette, table of contents, document history, and annotations.
fuzzy_searching 1

# Match searchable menus and the command line to the active Kanagawa Dragon
# palette instead of Sioyek's pure-black default.
ui_background_color #181616
ui_text_color #c5c9c5
ui_selected_background_color #393836
ui_selected_text_color #c5c9c5
status_bar_color #181616
status_bar_text_color #c5c9c5
ui_font Maple Mono NF

# Display the cover page as a single recto (right-hand) page in two-page mode,
# aligning subsequent pages as proper book spreads (even on left, odd on right).
recto_verso_adjustment 1

