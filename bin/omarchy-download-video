#!/usr/bin/env bash
# Download the active Chrome tab's video via the omarchy yt-dlp host.
#
# Chrome won't register keyboard shortcuts for --load-extension extensions, so
# the (documented) Alt+Shift+D extension shortcut is dead. This instead grabs
# the URL by focusing Chrome's address bar (Ctrl+L), copying it (Ctrl+C), and
# unfocusing (Escape), then hands the URL to the same native-messaging host the
# extension uses. Bind this to ALT+SHIFT+D so the physical Win+Shift+D (keyd
# maps Win->Alt) triggers it.
set -euo pipefail

# Give the user a beat to release the bind chord before injecting keys, so the
# held Alt/Shift modifiers don't merge into the synthetic Ctrl keystrokes.
sleep 0.5

wtype -M ctrl -k l -m ctrl   # focus address bar (selects the URL)
sleep 0.2
wtype -M ctrl -k c -m ctrl   # copy the URL
sleep 0.2
wtype -k Escape              # unfocus the address bar
sleep 0.1

url=$(wl-paste --no-newline 2>/dev/null || true)
if [[ "$url" != http* ]]; then
  notify-send -u critical "No URL" "Couldn't read a URL from Chrome's address bar"
  exit 1
fi

# Same download path (OSD progress + completion toast) as the extension.
exec omarchy-chromium-ytdlp-host --download "$url"
