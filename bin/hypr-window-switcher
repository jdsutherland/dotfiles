#!/usr/bin/env bash
# Numbered window picker for the current Hyprland workspace.
#
# Lists the workspace's windows with numbers ("1. <title>", ...), lets you pick
# one with fzf, and focuses it. Handles stacked/vertical layouts that
# directional focus (movefocus l/r) can't disambiguate.
set -euo pipefail

workspace_id=$(hyprctl activeworkspace -j | jq -r '.id')

# "address<TAB>title" for each window on the active workspace.
mapfile -t windows < <(hyprctl clients -j | jq -r --argjson ws "$workspace_id" '
  .[] | select(.workspace.id == $ws) | "\(.address)\t\(.title // .class)"
')

[[ ${#windows[@]} -gt 0 ]] || exit 0

# Numbered display list; fzf returns the chosen "N. title" line.
choice=$(printf '%s\n' "${windows[@]}" |
  awk -F'\t' '{ printf "%d. %s\n", NR, $2 }' |
  fzf --height 40% --reverse --prompt 'window> ' --no-multi || true)

[[ -n "$choice" ]] || exit 0

number=$(printf '%s\n' "$choice" | awk -F'.' '{ print $1 }')
address=$(printf '%s\n' "${windows[$((number - 1))]}" | awk -F'\t' '{ print $1 }')

hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })"
