#!/bin/bash
set -euo pipefail

# Alfred "sp $WORD" parity: prompt for a word, run it through hunspell's
# suggestion mode, pick a correction from a real list, copy the pick to the
# clipboard. Bound directly to hyper+J (see config/hypr/bindings.lua) rather
# than routed through the Omarchy menu -- see KEYBINDINGS.md.
#
# Requires hunspell-en_us (pacman). The `hunspell` binary alone ships no
# dictionary data, so without it every word reports as unknown.

word=$(omarchy-menu-input "Spell check" --width 400) || exit 0
[[ -n $word ]] || exit 0

# hunspell -a speaks the classic ispell pipe protocol: a banner line, then
# one result line per input word --
#   *              correct
#   + root         correct, root word given
#   # word offset  misspelled, no suggestions
#   & word count offset: s1, s2, ...   misspelled, with suggestions
result=$(hunspell -a <<<"$word" | tail -n +2 | head -1)

case "$result" in
'*'* | '+'*)
  omarchy-notification-send -g 󰗠 "Correctly spelled" "$word"
  ;;
'&'*)
  suggestions=${result#*: }
  IFS=',' read -ra opts <<<"$suggestions"
  opts=("${opts[@]## }")
  chosen=$(printf '%s\n' "${opts[@]}" | omarchy-menu-select "Suggestions for '$word'") || exit 0
  [[ -n $chosen ]] || exit 0
  printf '%s' "$chosen" | clip
  omarchy-notification-send -g 󰅍 "Copied to clipboard" "$chosen"
  ;;
*)
  omarchy-notification-send -u critical -g 󰅖 "No suggestions" "$word"
  ;;
esac
