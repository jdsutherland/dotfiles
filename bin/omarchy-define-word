#!/bin/bash
set -euo pipefail

# Alfred "def $WORD" parity: prompt for a word, look it up via the free
# dictionaryapi.dev API (no key needed), pick a part of speech from a real
# list, copy the full definition to clipboard. Bound directly to hyper+K
# (see config/hypr/bindings.lua) rather than routed through the Omarchy
# menu -- see KEYBINDINGS.md.

word=$(omarchy-menu-input "Define word" --width 400) || exit 0
[[ -n $word ]] || exit 0

encoded=$(printf '%s' "$word" | jq -sRr @uri)
response=$(curl -s --max-time 10 -w '\n%{http_code}' "https://api.dictionaryapi.dev/api/v2/entries/en/$encoded")
http_status=${response##*$'\n'}
body=${response%$'\n'*}

if [[ $http_status != 200 ]]; then
  omarchy-notification-send -u critical -g 󰅖 "No definition found" "$word"
  exit 0
fi

mapfile -t lines < <(jq -r '.[0].meanings[] | "\(.partOfSpeech): \(.definitions[0].definition)"' <<<"$body")
if [[ ${#lines[@]} -eq 0 ]]; then
  omarchy-notification-send -u critical -g 󰅖 "No definition found" "$word"
  exit 0
fi

chosen=$(printf '%s\n' "${lines[@]}" | omarchy-menu-select "Definitions for '$word'") || exit 0
[[ -n $chosen ]] || exit 0
printf '%s' "$chosen" | clip
omarchy-notification-send -g 󰗊 "Copied to clipboard" "$chosen"
